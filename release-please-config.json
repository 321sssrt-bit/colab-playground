{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bootstrap-sha": "61c92b2e8d70ee9cf6815d0d96d3117e92f6805b",
  "packages": {
    ".": {
      "release-type": "simple",
      "initial-version": "0.1.0",
      "include-component-in-tag": false,
      "include-v-in-tag": true,
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": false,
      "draft": true,
      "force-tag-creation": true,
      "extra-files": [
        {
          "type": "toml",
          "path": "Cargo.toml",
          "jsonpath": "$.workspace.package.version"
        },
        {
          "type": "toml",
          "path": "Cargo.lock",
          "jsonpath": "$.package[?(!@.source)].version"
        }
      ],
      "changelog-sections": [
        { "type": "feat", "section": "Added" },
        { "type": "change", "section": "Changed" },
        { "type": "perf", "section": "Changed" },
        { "type": "deprecate", "section": "Deprecated" },
        { "type": "remove", "section": "Removed" },
        { "type": "fix", "section": "Fixed" },
        { "type": "security", "section": "Security" },
        { "type": "revert", "section": "Reverted", "hidden": true },
        { "type": "docs", "section": "Documentation", "hidden": true },
        { "type": "refactor", "section": "Refactoring", "hidden": true },
        { "type": "test", "section": "Tests", "hidden": true },
        { "type": "build", "section": "Build", "hidden": true },
        { "type": "ci", "section": "CI", "hidden": true },
        { "type": "style", "section": "Style", "hidden": true },
        { "type": "chore", "section": "Chores", "hidden": true }
      ]
    }
  }
}
